          "options": [
            {
              "en": "Butane itself",
              "as": "বিউটেন নিজেই"
            },
            {
              "en": "An added smelly compound",
              "as": "যোগ কৰা গোন্ধযুক্ত যৌগ"
            },
            {
              "en": "Oxygen",
              "as": "অক্সিজেন"
