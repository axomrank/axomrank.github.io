      "title": {
        "en": "Piaget's building blocks",
        "as": "Piaget's building blocks"
      },
      "icon": "hill",
      "learned": [
        {
          "en": "A schema is an organised pattern of thinking.",
          "as": "A schema is an organised pattern of thinking."
        },
        {
          "en": "Assimilation fits new information into an existing schema.",
          "as": "Assimilation fits new information into an existing schema."
        },
        {
          "en": "Accommodation changes a schema to fit new information.",
          "as": "Accommodation changes a schema to fit new information."
        },
        {
          "en": "Equilibration is the drive to balance understanding.",
          "as": "Equilibration is the drive to balance understanding."
        }
      ],
      "steps": [
